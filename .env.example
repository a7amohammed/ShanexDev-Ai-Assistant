# J.A.R.V.I.S. Mk. LV - environment variable template
# Copy this file to ".env" (never commit it) or export the variables in your shell.
# Environment variables always take precedence over values stored in config/*.json.

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Spotify Web API application (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID_HERE
SPOTIFY_CLIENT_SECRET=YOUR_SPOTIFY_CLIENT_SECRET_HERE

# Mail app-passwords: JARVIS_MAIL_<ACCOUNT_ID>_PASSWORD, where <ACCOUNT_ID> is the
# account identifier in upper case with non-alphanumeric characters replaced by "_".
# Example for an account whose id is "icloud":
JARVIS_MAIL_ICLOUD_PASSWORD=YOUR_APP_PASSWORD_HERE
